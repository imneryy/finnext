NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never expose this in client components or NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# IA (chat de lancamentos). Server-only. Nunca use NEXT_PUBLIC_ para a chave.
# Usamos o Google Gemini via endpoint compativel com a OpenAI (tier gratuito).
# Gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Opcional: modelo usado na extracao (default gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest
